<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_FORM_ID_alter() for node edit forms.
 *
 * Attach our validation handler instead of relying on a hard exception.
 */
function gsoc_ai_moderator_form_node_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $form['#validate'][] = 'gsoc_ai_moderator_node_form_validate';
}

/**
 * Custom validator for node forms; called during normal user saves.
 */
function gsoc_ai_moderator_node_form_validate(array &$form, FormStateInterface $form_state) {
  $body = '';
  $values = $form_state->getValues();
  if (isset($values['body'][0]['value'])) {
    $body = $values['body'][0]['value'];
  }

  $moderator = \Drupal::service('gsoc_ai_moderator.content_moderator');
  $result = $moderator->scanText($body);

  if ($result['flagged']) {
    $form_state->setErrorByName('body', t(
      'Your content contains forbidden words: @list. Please remove or reword them.',
      ['@list' => implode(', ', $result['keywords'])]
    ));
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Called for all saves, including programmatic ones.  We no longer abort the
 * save; instead, warnings are shown and the content could later be queued for
 * manual review.  This improves UX and avoids scary exception pages.
 */
function gsoc_ai_moderator_entity_presave(EntityInterface $entity) {
  if ($entity instanceof ContentEntityInterface && $entity->getEntityTypeId() === 'node' && $entity->hasField('body')) {
    $body = $entity->get('body')->value;
    $moderator = \Drupal::service('gsoc_ai_moderator.content_moderator');
    $result = $moderator->scanText($body);
    $moderator->handleFlags($result);
  }
}
